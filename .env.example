# Zkopíruj jako .env a vyplň. Soubor .env se nikam neverzuje.

# Doména, která míří na tvůj server (A záznam na jeho IP). Např. spojeuk.duckdns.org
DOMAIN=spojeuk.duckdns.org

# Klíč CARTO pro podkladovou mapu (stejný jako CARTO_API_KEY v Androidu). Bez něj se použije OpenFreeMap.
CARTO_API_KEY=

# Tvůj spoje-feed server s /duk/traffic a /dpmul/traffic
SERVER_BASE=http://37.46.211.70:8787

# Volitelné: záloha přímo na API DPMÚL, když tvůj server nemá čerstvá data
# DPMUL_API_KEY=
